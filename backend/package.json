{
  "name": "growl-backend",
  "version": "1.0.0",
  "description": "Growl App Backend - Cloudflare Workers API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply growl-db",
    "migrate:local": "wrangler d1 migrations apply growl-db --local",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run migrate:local",
    "seed:local": "wrangler d1 execute growl-db --local --file=scripts/seed-products-enhanced.sql",
    "seed:remote": "wrangler d1 execute growl-db --remote --file=scripts/seed-products-enhanced.sql",
    "db:create": "wrangler d1 create growl-db",
    "login": "wrangler login",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "NODE_OPTIONS=--experimental-global-webcrypto vitest run",
    "test:watch": "NODE_OPTIONS=--experimental-global-webcrypto vitest",
    "test:ui": "NODE_OPTIONS=--experimental-global-webcrypto vitest --ui",
    "test:coverage": "NODE_OPTIONS=--experimental-global-webcrypto vitest run --coverage",
    "test:integration": "node tests/test-api.js",
    "test:local": "API_BASE_URL=http://localhost:8787/api/v1 node tests/test-api.js"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "api",
    "growl"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@types/node": "^20.11.0",
    "@vitest/ui": "^2.1.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0",
    "wrangler": "^3.114.16"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "node-fetch": "^2.7.0"
  }
}
